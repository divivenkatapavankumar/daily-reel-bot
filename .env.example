# Required: Free Gemini API Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Free Pexels API Key from https://www.pexels.com/api/ (falls back to Pollinations.ai free AI images if omitted)
PEXELS_API_KEY=your_pexels_api_key_here

# Trend, Pacing & Video Duration Preferences (125s - 175s = 2 to 2.9 minutes)
TREND_GEO=IN
NICHE_FILTER="technology, AI, science, business, finance, or fascinating world news"
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
MIN_VIDEO_SECONDS=125
MAX_VIDEO_SECONDS=175
VISUAL_SOURCE=auto

# YouTube Data API v3 (run `python daily_reel_bot.py --setup-youtube` once locally to generate)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# Instagram Option A: Official Meta Instagram Graph API (Recommended for Creator/Business accounts)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Instagram Option B: instagrapi Fallback
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_JSON=
